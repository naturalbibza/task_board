# Скопируйте в .env и заполните. Секреты в репозиторий не коммитить.

PORT=3001

# --- С фазы 1 (аккаунты) ---
JWT_SECRET=change-me-to-random-string-min-32-characters
# Локально: контейнер task-board-db слушает 5433; на проде (compose) — 5432.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/task_board

# --- На проде (фаза 2) ---
COOKIE_DOMAIN=example.com
ORIGIN=https://example.com
