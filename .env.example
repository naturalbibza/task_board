# Скопируйте в packages/server/.env и заполните. Секреты в репозиторий не коммитить.
#
# ВСЁ НИЖЕ НЕОБЯЗАТЕЛЬНО (автономный режим, NFR-10): если переменные не заданы,
# сервер сам поднимает встроенный PostgreSQL (порт 54329, данные в
# packages/server/.localdb) и генерирует JWT-секрет в packages/server/.localdb/jwt_secret.
# Заданные значения имеют приоритет над офлайн-режимом.

PORT=3001

# --- С фазы 1 (аккаунты) ---
JWT_SECRET=
# Локально: контейнер task-board-db слушает 5433; на проде (compose) — 5432.
DATABASE_URL=

# --- На проде (фаза 2) ---
COOKIE_DOMAIN=example.com
ORIGIN=https://example.com
# Адрес(а) сайта для Caddy (TLS включается автоматически, если указан домен);
# не задано — HTTP :80. Несколько адресов — через запятую С ПРОБЕЛОМ.
SITE_ADDRESS=example.com
