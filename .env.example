# Скопируйте в packages/server/.env и заполните. Секреты в репозиторий не коммитить.
#
# РЕЖИМ БД (USE_EXTERNAL_DB):
#   не задан   — авто: есть DATABASE_URL → внешняя БД, нет → встроенный PostgreSQL
#   =1         — внешняя БД: обязательны DATABASE_URL и JWT_SECRET
#                (понятная ошибка при старте, если не заданы)
#   =0         — встроенный PostgreSQL (порт 54329, данные
#                packages/server/.localdb), DATABASE_URL игнорируется

PORT=3001

# --- С фазы 1 (аккаунты) ---
JWT_SECRET=
# Локально: контейнер task-board-db слушает 5433; на проде (compose) — 5432.
DATABASE_URL=

# --- На проде (фаза 2) ---
COOKIE_DOMAIN=example.com
ORIGIN=https://example.com
# Адрес(а) сайта для Caddy (TLS включается автоматически, если указан домен);
# не задано — HTTP :80. Несколько адресов — через запятую С ПРОБЕЛОМ.
SITE_ADDRESS=example.com

# --- Почта (v2, фаза 14) ---
# console — письма пишутся в packages/server/.localmail/*.eml и в лог (dev/офлайн);
# smtp — реальная отправка. Для smtp обязательны SMTP_HOST/USER/PASS и MAIL_FROM.
MAIL_MODE=console
# Яндекс SMTP: smtp.yandex.ru, порт 465 (SSL) или 587 (STARTTLS),
# SMTP_PASS — «пароль приложения» из настроек Яндекс ID, не обычный пароль.
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
# 1 — SSL (порт 465), 0 — STARTTLS (порт 587)
SMTP_SECURE=1
SMTP_USER=
SMTP_PASS=
# Адрес отправителя: для Яндекса — сам ящик (домен нужно делегировать отдельно)
MAIL_FROM=
MAIL_FROM_NAME=Task Board
