# Скопируйте в packages/server/.env и заполните. Секреты в репозиторий не коммитить.
#
# РЕЖИМ БД (USE_EXTERNAL_DB):
#   не задан   — авто: есть DATABASE_URL → внешняя БД, нет → встроенный PostgreSQL
#   =1         — внешняя БД: обязательны DATABASE_URL и JWT_SECRET
#                (понятная ошибка при старте, если не заданы)
#   =0         — встроенный PostgreSQL (порт 54329, данные
#                packages/server/.localdb), DATABASE_URL игнорируется

PORT=3001

# --- С фазы 1 (аккаунты) ---
JWT_SECRET=
# Локально: контейнер task-board-db слушает 5433; на проде (compose) — 5432.
DATABASE_URL=

# --- На проде (фаза 2) ---
COOKIE_DOMAIN=example.com
ORIGIN=https://example.com
# Адрес(а) сайта для Caddy (TLS включается автоматически, если указан домен);
# не задано — HTTP :80. Несколько адресов — через запятую С ПРОБЕЛОМ.
SITE_ADDRESS=example.com
